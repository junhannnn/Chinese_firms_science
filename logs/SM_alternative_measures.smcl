{txt}
{com}. 
. * ==============================================================================
. * 3. Estimate the WOS publication-indicator model
. * ==============================================================================
. 
. use ${c -(}RUN5_STATA_WOS{c )-}CN_WOS_DID.dta, clear
{txt}
{com}. 
. * Construct the WOS publication indicator from the publication count.
. gen pub_num_dummy = 1
{txt}
{com}. replace pub_num_dummy=0 if pub_num==0
{txt}(995,294 real changes made)

{com}. 
. reghdfe pub_num_dummy did, absorb(year firm_id) vce(r)
{res}{txt}({browse "http://scorreia.com/research/hdfe.pdf":MWFE estimator} converged in 2 iterations)
{res}
{txt}HDFE Linear regression{col 51}Number of obs{col 67}= {res} 1,153,256
