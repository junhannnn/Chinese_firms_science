{com}. * ==============================================================================
. * 4. Export the combined alternative-outcome table
. * ==============================================================================
. 
. esttab M1 M2 M3 M4 using ${c -(}RUN5_TABLE_CN_CN{c )-}robust_alternative_measures.rtf, ///
>         replace star( * 0.10 ** 0.05 *** 0.01 ) nogaps compress order(did) ///
>         b(%20.3f) se(%7.3f) r2(%9.3f) ///
>         stats(N r2 r2_p, fmt(%15.0fc %9.3f %9.3f) labels("Observations" "R2" "Pseudo R2")) ///
>         mtitles("Model 1" "Model 2" "Model 3" "Model 4") ///
>         nonotes
{res}{txt}(output written to {browse  `"W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\Sci_Pat/../../table_output/CN_CN/robust_alternative_measures.rtf"'})

{com}. 
