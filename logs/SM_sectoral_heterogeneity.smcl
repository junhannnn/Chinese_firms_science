{txt}  4{com}. 
.         count
{txt}  5{com}.         if r(N) == 0 {c -(}
{txt}  6{com}.             restore
{txt}  7{com}.             continue
{txt}  8{com}.         {c )-}
{txt}  9{com}. 
.         * Apply the same science-linked definition used in the annual trend graphs.
.         capture drop cite_science_bin
{txt} 10{com}.         gen byte cite_science_bin = (cite_science > 0) if !missing(cite_science)
{txt} 11{com}.         replace cite_science_bin = 0 if missing(cite_science_bin)
{txt} 12{com}. 
.         gen byte one = 1
{txt} 13{com}. 
.         collapse ///
>             (sum) patent_total = one ///
>                   sci_reliant_patent = cite_science_bin, ///
>             by(year)
{txt} 14{com}. 
.         gen double share = sci_reliant_patent / patent_total if patent_total > 0
{txt} 15{com}. 
.         keep if inlist(year, 2010, 2022)
{txt} 16{com}. 
