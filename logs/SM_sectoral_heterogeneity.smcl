{com}. do "W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\Sci_Pat\3_Supplementary_materials\F4_Additional_analyses\03_Sector_heterogeneity\3_section_time_trend_by_sector.do"
{txt}
{com}. /*******************************************************************************
> Project: Science-linked patents—supplementary sector heterogeneity
> Script:  3_section_time_trend_by_sector.do
> 
> Purpose:
>   Describe trends in Chinese firms' science-linked patents across eight broad IPC
>   sections. Produce section-specific annual line graphs and compare 2010 with
>   2022 using bubble plots.
> 
> Main inputs (from ${c -(}stata_output{c )-}):
>   - Chinese_patents_filed_by_EL_otherfirms.dta
>   - CNpatents_mainipc.dta
> 
> Main outputs (under ${c -(}figure_output{c )-}):
>   - bg_CNfirm_CNpat_bysectionsector.gph: annual trends by IPC section
>   - bg_CNfirm_CNpat_bysectionsector_bubble.gph: 2010–2022 section comparison
> 
> Notes:
>   Temporary component graphs are written under ${c -(}temp_output{c )-} and deleted after
>   combination.
> *******************************************************************************/
. 
. * ==============================================================================
. * 1. Merge IPC data and construct broad section indicators
. * ==============================================================================
. 
. use "${c -(}stata_output{c )-}Chinese_patents_filed_by_EL_otherfirms.dta", clear
{txt}
{com}. 
. * Attach each patent's main IPC classification.
. merge 1:1 apn using "${c -(}stata_output{c )-}CNpatents_mainipc.dta"
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}       4,120,012
{txt}{col 9}from master{col 30}{res}               0{txt}  (_merge==1)
{col 9}from using{col 30}{res}       4,120,012{txt}  (_merge==2)

{col 5}Matched{col 30}{res}       4,433,806{txt}  (_merge==3)
{col 5}{hline 41}

{com}. drop if _merge==2
{txt}(4,120,012 observations deleted)

{com}. drop _merge
{txt}
{com}. 
. gen industry_section = substr(ipc_subclass, 1, 1)
{txt}
{com}. encode industry_section, gen(industry_section_id)
{txt}
{com}. 
. 
. foreach l in A B C D E F G H {c -(}
{txt}  2{com}.     gen is_`l' = 0
{txt}  3{com}.     replace is_`l' = 1 if industry_section == "`l'"
{txt}  4{com}. {c )-}
{txt}(304,733 real changes made)
(889,052 real changes made)
(517,758 real changes made)
(72,146 real changes made)
(206,179 real changes made)
(310,692 real changes made)
(1,168,852 real changes made)
(964,394 real changes made)

{com}. 
. egen n_sectors = rowtotal(is_A is_B is_C is_D is_E is_F is_G is_H)
{txt}
{com}. gen byte is_all = (n_sectors>0)
{txt}
{com}. * ==============================================================================
. * 2. Define display titles for the aggregate and section-specific graphs
. * ==============================================================================
. local ttl_all  "All fields"
{txt}
{com}. 
. local ttl_A    "Field A"
{txt}
{com}. local ttl_B    "Field B"
{txt}
{com}. local ttl_C    "Field C"
{txt}
{com}. local ttl_D    "Field D"
{txt}
{com}. local ttl_E    "Field E"
{txt}
{com}. local ttl_F    "Field F"
{txt}
{com}. local ttl_G    "Field G"
{txt}
{com}. local ttl_H    "Field H"
{txt}
{com}. * ==============================================================================
. * 3. Create annual trend graphs for all patents and eight IPC sections
. * ==============================================================================
. local sectors "all A B C D E F G H"
{txt}
{com}. 
. foreach s of local sectors {c -(}
{txt}  2{com}. 
.     preserve
{txt}  3{com}. 
.     * Retain the aggregate sample or the current IPC section.
.     keep if is_`s'==1
{txt}  4{com}. 
.     * Retrieve the display title from the mapping locals.
.     local ttl "`ttl_`s''"
{txt}  5{com}. 
.     * Standardize the year variable name for plotting.
.     rename grtyr year
{txt}  6{com}. 
.     * Construct annual patent and science-reliance totals.
.     bys year: gen patent_grtyr = _N
{txt}  7{com}.     bys year: egen sci_reliant_patent_grtyr = total(cite_science)
{txt}  8{com}. 
.     * Count unique firms in each year.
.     bys year fapp_standard: gen byte firm1 = (_n==1)
{txt}  9{com}.     bys year: egen unique_firm_yr = total(firm1)
{txt} 10{com}.     drop firm1
{txt} 11{com}. 
.     * Count firms with at least one science-reliant patent in each year.
.     bys year fapp_standard: egen has_citesci = max(cite_science)
{txt} 12{com}.     bys year fapp_standard: gen byte citesci_firm1 = (_n==1 & has_citesci==1)
{txt} 13{com}.     bys year: egen unique_citesci_firm_yr = total(citesci_firm1)
{txt} 14{com}.     drop citesci_firm1
{txt} 15{com}. 
.     * Retain one record per annual series.
.     keep year sci_reliant_patent_grtyr unique_firm_yr unique_citesci_firm_yr patent_grtyr
{txt} 16{com}.     duplicates drop
{txt} 17{com}. 
.     * Construct annual shares and firm-adjusted measures.
.     gen sci_reliant_ratio_grtyr = sci_reliant_patent_grtyr / patent_grtyr
{txt} 18{com}.     gen sci_reliant_patent_grtyr_adj1 = sci_reliant_patent_grtyr / unique_firm_yr
{txt} 19{com}.     gen sci_reliant_patent_grtyr_adj2 = sci_reliant_patent_grtyr / unique_citesci_firm_yr
{txt} 20{com}. 
.     * Restrict the displayed series to 2010–2022.
.     keep if year>=2010 & year<=2022
{txt} 21{com}. 
.     * Prepare endpoint indicators and labels for 2010 and 2022.
.     gen byte ep2010 = (year==2010)
{txt} 22{com}.     gen byte ep2022 = (year==2022)
{txt} 23{com}. 
.     gen str num_label = string(sci_reliant_patent_grtyr, "%9.0fc")
{txt} 24{com}.     gen str pct_label = string(sci_reliant_ratio_grtyr*100, "%9.2f") + "%"
{txt} 25{com}. 
.     gen double year_lbl_1 = year
{txt} 26{com}.     replace year_lbl_1 = year + 0.50 if year==2010
{txt} 27{com}.     replace year_lbl_1 = year - 0.50 if year==2022
{txt} 28{com}. 
.     gen double year_lbl_2 = year
{txt} 29{com}.     replace year_lbl_2 = year + 0.20 if year==2010
{txt} 30{com}.     replace year_lbl_2 = year - 0.20 if year==2022
{txt} 31{com}. 
.     * Plot the annual number and share on separate y-axes.
.     twoway ///
>         (connected sci_reliant_patent_grtyr year, ///
>             yaxis(1) lwidth(medium) lcolor(red*1.4) lpattern(solid) ///
>             msymbol(square) mcolor(red*1.5) msize(vsmall)) || ///
>         (connected sci_reliant_ratio_grtyr year, ///
>             yaxis(2) lwidth(medium) lcolor(ebblue*1.2) lpattern(dash) ///
>             msymbol(circle) mcolor(ebblue*1.5) msize(vsmall)) || ///
>         (scatter sci_reliant_patent_grtyr year_lbl_1 if ep2010, ///
>             yaxis(1) msymbol(none) ///
>             mlabel(num_label) mlabposition(6) mlabgap(0) ///
>             mlabsize(small) mlabcolor(red*1.5)) || ///
>         (scatter sci_reliant_patent_grtyr year_lbl_2 if ep2022, ///
>             yaxis(1) msymbol(none) ///
>             mlabel(num_label) mlabposition(11) mlabgap(-1) ///
>             mlabsize(small) mlabcolor(red*1.5)) || ///
>         (scatter sci_reliant_ratio_grtyr year_lbl_1 if ep2010, ///
>             yaxis(2) msymbol(none) ///
>             mlabel(pct_label) mlabposition(6) mlabgap(1) ///
>             mlabsize(small) mlabcolor(ebblue*1.5)) || ///
>         (scatter sci_reliant_ratio_grtyr year_lbl_1 if ep2022, ///
>             yaxis(2) msymbol(none) ///
>             mlabel(pct_label) mlabposition(12) mlabgap(1) ///
>             mlabsize(small) mlabcolor(ebblue*1.5)), ///
>         title("{c -(}bf:`ttl'{c )-}", size(medsmall)) ///
>         ytitle("Number", axis(1) size(small)) ///
>         ytitle("Share", axis(2) size(small)) ///
>         ylabel(0(10000)40000, axis(1) labsize(small) format(%9.0f)) ///
>         ylabel(0 0.1 "10%" 0.2 "20%" 0.3 "30%" 0.4 "40%" 0.5 "50%" 0.6 "60%", ///
>                axis(2) labsize(small)) ///
>         xtitle("Year", size(small) placement(east)) ///
>         xlabel(2010(2)2022, angle(45) labsize(small)) ///
>         legend(off) ///
>         graphregion(margin(vsmall))
{txt} 32{com}. 
.     * Save the component graph for later combination.
.     graph save "${c -(}temp_output{c )-}bg_CNfirm_CNpat_`s'.gph", replace
{txt} 33{com}. 
.     restore
{txt} 34{com}. {c )-}
