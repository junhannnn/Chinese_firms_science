{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}W:\Mac_Sync\Desktop\public_release_science_20260904\logs\SM_sectoral_heterogeneity.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res} 5 Sep 2026, 16:21:59

{com}. do "W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\Sci_Pat\3_Supplementary_materials\F4_Additional_analyses\03_Sector_heterogeneity\1_critical_time_trend_by_sector.do"
{txt}
{com}. /*******************************************************************************
> Project: Science-linked patents—supplementary sector heterogeneity
> Script:  1_critical_time_trend_by_sector.do
> 
> Purpose:
>   Classify Chinese firms' patents into 11 NSF/TIP critical technology areas and
>   describe changes in science-linked patenting from 2010 through 2022. Produce
>   annual trend panels and endpoint bubble plots by technology area.
> 
> Main inputs (from ${c -(}stata_output{c )-}):
>   - Chinese_patents_filed_by_EL_otherfirms.dta
>   - CNpatents_mainipc.dta
> 
> Main outputs (under ${c -(}figure_output{c )-}):
>   - bg_CNfirm_CNpat_bysector.gph: annual trends by critical technology area
>   - bg_CNfirm_CNpat_bysector_bubble.gph: 2010–2022 technology-area comparison
> 
> Notes:
>   Quantum information science and cybersecurity use broad IPC4 proxies. Temporary
>   component graphs are written under ${c -(}temp_output{c )-} and deleted after combination.
> *******************************************************************************/
. 
. * ==============================================================================
. * 1. Merge patent IPC data and standardize classification codes
. * ==============================================================================
. 
. use "${c -(}stata_output{c )-}Chinese_patents_filed_by_EL_otherfirms.dta", clear
{txt}
{com}. 
. * Attach each patent's main IPC classification.
. merge 1:1 apn using "${c -(}stata_output{c )-}CNpatents_mainipc.dta"
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}       4,120,012
{txt}{col 9}from master{col 30}{res}               0{txt}  (_merge==1)
{col 9}from using{col 30}{res}       4,120,012{txt}  (_merge==2)

{col 5}Matched{col 30}{res}       4,433,806{txt}  (_merge==3)
{col 5}{hline 41}

{com}. drop if _merge==2
{txt}(4,120,012 observations deleted)

{com}. drop _merge
{txt}
{com}. 
. * The workflow uses `ipc_subclass` as the source IPC classification.
. 
. capture drop ipc_raw ipc_clean ipc4_std ipc3_std
{txt}
{com}. 
. capture confirm string variable ipc_subclass
{txt}
{com}. if _rc {c -(}
.     tostring ipc_subclass, gen(ipc_raw) force usedisplayformat
. {c )-}
{txt}
{com}. else {c -(}
.     gen str80 ipc_raw = ipc_subclass
. {c )-}
{txt}
{com}. 
. gen str80 ipc_clean = upper(strtrim(ipc_raw))
{txt}
{com}. replace ipc_clean = subinstr(ipc_clean, " ", "", .)
{txt}(0 real changes made)

{com}. replace ipc_clean = subinstr(ipc_clean, ".", "", .)
{txt}(0 real changes made)

{com}. replace ipc_clean = subinstr(ipc_clean, "/", "", .)
{txt}(0 real changes made)

{com}. replace ipc_clean = subinstr(ipc_clean, "-", "", .)
{txt}(0 real changes made)

{com}. 
. gen str4 ipc4_std = substr(ipc_clean, 1, 4)
{txt}
{com}. gen str3 ipc3_std = substr(ipc_clean, 1, 3)
{txt}
{com}. 
. * ==============================================================================
. * 2. Construct indicators for 11 NSF/TIP critical technology areas
. * ==============================================================================
. 
. local techvars ai adv_mfg adv_comm biotech quantum semi adv_energy ///
>                adv_mat disaster cyber cyberinfra
{txt}
{com}. 
. foreach v of local techvars {c -(}
{txt}  2{com}.     capture drop is_`v'
{txt}  3{com}.     gen byte is_`v' = 0
{txt}  4{com}. {c )-}
{txt}
{com}. 
. * Technology area 1: Artificial Intelligence.
. 
. replace is_ai = 1 if inlist(ipc4_std, "G06N", "G06V", "G06T", "G06K", "G10L")
{txt}(156,082 real changes made)

{com}. label var is_ai "Artificial Intelligence"
{txt}
{com}. 
. * Technology area 2: Advanced Manufacturing.
.                           
. replace is_adv_mfg = 1 if inlist(ipc3_std, "B21", "B22", "B23", "B24", "B29") ///
>                       | inlist(ipc4_std, "B25J", "B30B", "B33Y", "G05B") ///
>                       | inlist(ipc4_std, "B22F", "B23K", "B23Q", "B29C")
{txt}(347,551 real changes made)

{com}. label var is_adv_mfg "Advanced Manufacturing"
{txt}
{com}. 
. * Technology area 3: Communications and Wireless.
. 
. replace is_adv_comm = 1 if inlist(ipc4_std, "H04B", "H04L", "H04W", "H01Q")
{txt}(343,745 real changes made)

{com}. label var is_adv_comm "Communications and Wireless"
{txt}
{com}. 
. * Technology area 4: Biotechnology.
. 
. replace is_biotech = 1 if inlist(ipc4_std, "C12N", "C12P", "C12Q", "C07K") ///
>                       | inlist(ipc4_std, "A61K", "A61P")
{txt}(106,015 real changes made)

{com}. label var is_biotech "Biotechnology"
{txt}
{com}. 
. * Technology area 5: Quantum Information Science.
. 
. * IPC4 cannot identify quantum precisely.
. * This is a broad IPC4-level proxy.
. replace is_quantum = 1 if inlist(ipc4_std, "G06N", "G02B", "H01L", "H01S")
{txt}(145,211 real changes made)

{com}. label var is_quantum "Quantum Information Science"
{txt}
{com}. 
. * Technology area 6: Semiconductors and Microelectronics.
. 
. replace is_semi = 1 if inlist(ipc4_std, "H01L", "G11C", "B81B", "B81C") ///
>                    | inlist(ipc4_std, "H10B", "H10D", "H10F", "H10H") ///
>                    | inlist(ipc4_std, "H10K", "H10N", "H10P", "H10W") ///
>                    | inlist(ipc4_std, "C30B", "H05K")
{txt}(158,909 real changes made)

{com}. label var is_semi "Semiconductors and Microelectronics"
{txt}
{com}. 
. * Technology area 7: Energy Technology.
. 
. replace is_adv_energy = 1 if inlist(ipc4_std, "H01M", "F03D", "H02J", ///
>                                     "C25B", "F24S", "H02S")
{txt}(126,178 real changes made)

{com}. label var is_adv_energy "Energy Technology"
{txt}
{com}. 
. * Technology area 8: Advanced Materials.
.                                           
. replace is_adv_mat = 1 if inlist(ipc4_std, "C01B", "C03C", "C04B", "C08J") ///
>                       | inlist(ipc4_std, "C08K", "C08L", "C09D", "C09K") ///
>                       | inlist(ipc4_std, "C21D", "C22C", "C22F", "C23C") ///
>                       | inlist(ipc4_std, "C23F", "C25D", "B32B", "B82Y") ///
>                       | inlist(ipc4_std, "H01B")
{txt}(236,998 real changes made)

{com}. label var is_adv_mat "Advanced Materials"
{txt}
{com}. 
. * Technology area 9: Cyberinfrastructure and Advanced Computing.
. 
. replace is_cyberinfra = 1 if inlist(ipc4_std, "G06F", "G06N", "G06E", "G06T") ///
>                          | inlist(ipc4_std, "G06V", "G11C", "H04L")
{txt}(709,744 real changes made)

{com}. label var is_cyberinfra "Cyberinfrastructure and Advanced Computing"
{txt}
{com}. 
. * Technology area 10: Disaster Risk and Resilience.
. 
. replace is_disaster = 1 if inlist(ipc4_std, "G08B", "G01W", "G01V", "E02B") ///
>                        | inlist(ipc4_std, "A62C", "A62D", "G01S")
{txt}(51,863 real changes made)

{com}. label var is_disaster "Disaster Risk and Resilience"
{txt}
{com}. 
. * Technology area 11: Cybersecurity.
. 
. * IPC4 cannot isolate cybersecurity precisely.
. * H04L, G06F, and H04W are broad IPC4-level proxies.
. replace is_cyber = 1 if inlist(ipc4_std, "H04L", "G06F", "H04W")
{txt}(685,534 real changes made)

{com}. label var is_cyber "Cybersecurity"
{txt}
{com}. 
. * Combine the area indicators into an overall critical-technology indicator.
. 
. capture drop n_sectors is_all_cta
{txt}
{com}. 
. egen n_sectors = rowtotal(is_ai is_adv_mfg is_adv_comm is_biotech ///
>                           is_quantum is_semi is_adv_energy is_adv_mat ///
>                           is_cyberinfra is_disaster is_cyber)
{txt}
{com}. label var n_sectors "Number of NSF/TIP technology areas matched"
{txt}
{com}. 
. gen byte is_all_cta = (n_sectors > 0)
{txt}
{com}. label var is_all_cta "All NSF/TIP critical technology areas"
{txt}
{com}. 
. * ==============================================================================
. * 3. Define technology-area display titles
. * ==============================================================================
. 
. local ttl_ai          "Artificial Intelligence"
{txt}
{com}. local ttl_adv_mfg     "Advanced Manufacturing"
{txt}
{com}. local ttl_adv_comm    "Communications and Wireless"
{txt}
{com}. local ttl_biotech     "Biotechnology"
{txt}
{com}. local ttl_quantum     "Quantum Information Science"
{txt}
{com}. local ttl_semi        "Semiconductors and Microelectronics"
{txt}
{com}. local ttl_adv_energy  "Energy Technology"
{txt}
{com}. local ttl_adv_mat     "Advanced Materials"
{txt}
{com}. local ttl_cyberinfra  "Cyberinfrastructure and Advanced Computing"
{txt}
{com}. local ttl_disaster    "Disaster Risk and Resilience"
{txt}
{com}. local ttl_cyber       "Cybersecurity"
{txt}
{com}. local ttl_all_cta     "All critical technology areas"
{txt}
{com}. 
. * ==============================================================================
. * 4. Create annual trend graphs for 11 areas and their aggregate
. * ==============================================================================
. 
. local sectors all_cta ai adv_mfg adv_comm biotech quantum semi adv_energy ///
>               adv_mat cyberinfra disaster cyber
{txt}
{com}. 
. foreach s of local sectors {c -(}
{txt}  2{com}. 
.     preserve
{txt}  3{com}. 
.     local ttl "`ttl_`s''"
{txt}  4{com}. 
.     * Retain the aggregate sample or the current technology area.
.     keep if is_`s' == 1
{txt}  5{com}. 
.     * Standardize the year variable name for plotting.
.     capture drop year
{txt}  6{com}.     rename grtyr year
{txt}  7{com}. 
.     * Restrict the displayed series to 2010–2022.
.     keep if year >= 2010 & year <= 2022
{txt}  8{com}. 
.     * Create a placeholder when an area has no observations in the sample window.
.     count
{txt}  9{com}.     if r(N) == 0 {c -(}
{txt} 10{com}.         clear
{txt} 11{com}.         set obs 1
{txt} 12{com}.         gen year = 2010
{txt} 13{com}.         gen y = 0
{txt} 14{com}. 
.         twoway (scatter y year, msymbol(none)), ///
>             title("{c -(}bf:`ttl'{c )-}", size(medsmall)) ///
>             note("No matched patents in 2010-2022", size(vsmall)) ///
>             ytitle("Number", size(small)) ///
>             xtitle("Year", size(small) placement(east)) ///
>             xlabel(2010(2)2022, angle(45) labsize(small)) ///
>             ylabel(0 "0", labsize(small)) ///
>             legend(off) ///
>             graphregion(margin(vsmall))
{txt} 15{com}. 
.         graph save "${c -(}temp_output{c )-}bg_CNfirm_CNpat_`s'.gph", replace
{txt} 16{com}. 
.         restore
{txt} 17{com}.         continue
{txt} 18{com}.     {c )-}
{txt} 19{com}. 
.     * Construct annual patent, science-reliance, and unique-firm totals.
. 
.     * Construct a binary science-reliant patent indicator.
.     capture drop cite_science_bin
{txt} 20{com}.     gen byte cite_science_bin = (cite_science > 0) if !missing(cite_science)
{txt} 21{com}.     replace cite_science_bin = 0 if missing(cite_science_bin)
{txt} 22{com}. 
.     * Create the unit count used to total patents.
.     gen byte patent_one = 1
{txt} 23{com}. 
.     * Identify unique firms in each year.
.     sort year fapp_standard
{txt} 24{com}.     by year fapp_standard: gen byte firm1 = (_n == 1 & !missing(fapp_standard))
{txt} 25{com}. 
.     * Identify firms with at least one science-reliant patent in each year.
.     by year fapp_standard: egen has_citesci = max(cite_science_bin)
{txt} 26{com}.     by year fapp_standard: gen byte citesci_firm1 = ///
>         (_n == 1 & has_citesci == 1 & !missing(fapp_standard))
{txt} 27{com}. 
.     * Collapse the patent records to annual totals.
.     collapse ///
>         (sum) patent_grtyr = patent_one ///
>               sci_reliant_patent_grtyr = cite_science_bin ///
>               unique_firm_yr = firm1 ///
>               unique_citesci_firm_yr = citesci_firm1, ///
>         by(year)
{txt} 28{com}. 
.     * Construct annual shares and firm-adjusted measures.
.     gen sci_reliant_ratio_grtyr = sci_reliant_patent_grtyr / patent_grtyr ///
>         if patent_grtyr > 0
{txt} 29{com}. 
.     gen sci_reliant_patent_grtyr_adj1 = sci_reliant_patent_grtyr / unique_firm_yr ///
>         if unique_firm_yr > 0
{txt} 30{com}. 
.     gen sci_reliant_patent_grtyr_adj2 = sci_reliant_patent_grtyr / unique_citesci_firm_yr ///
>         if unique_citesci_firm_yr > 0
{txt} 31{com}. 
.     * Prepare endpoint indicators and labels for 2010 and 2022.
. 
.     gen byte ep2010 = (year == 2010)
{txt} 32{com}.     gen byte ep2022 = (year == 2022)
{txt} 33{com}. 
.     gen str20 num_label = strtrim(string(sci_reliant_patent_grtyr, "%9.0fc"))
{txt} 34{com}.     gen str20 pct_label = strtrim(string(sci_reliant_ratio_grtyr * 100, "%9.2f")) + "%"
{txt} 35{com}. 
.     gen double year_lbl_1 = year
{txt} 36{com}.     replace year_lbl_1 = year + 0.50 if year == 2010
{txt} 37{com}.     replace year_lbl_1 = year - 0.50 if year == 2022
{txt} 38{com}. 
.     gen double year_lbl_2 = year
{txt} 39{com}.     replace year_lbl_2 = year + 0.20 if year == 2010
{txt} 40{com}.     replace year_lbl_2 = year - 0.20 if year == 2022
{txt} 41{com}. 
.     * Plot annual patent numbers and shares on separate y-axes.
. 
.     twoway ///
>         (connected sci_reliant_patent_grtyr year, ///
>             yaxis(1) lwidth(medium) lcolor(red*1.4) lpattern(solid) ///
>             msymbol(square) mcolor(red*1.5) msize(vsmall)) || ///
>         (connected sci_reliant_ratio_grtyr year, ///
>             yaxis(2) lwidth(medium) lcolor(ebblue*1.2) lpattern(dash) ///
>             msymbol(circle) mcolor(ebblue*1.5) msize(vsmall)) || ///
>         (scatter sci_reliant_patent_grtyr year_lbl_1 if ep2010, ///
>             yaxis(1) msymbol(none) ///
>             mlabel(num_label) mlabposition(6) mlabgap(0) ///
>             mlabsize(small) mlabcolor(red*1.5)) || ///
>         (scatter sci_reliant_patent_grtyr year_lbl_2 if ep2022, ///
>             yaxis(1) msymbol(none) ///
>             mlabel(num_label) mlabposition(11) mlabgap(-1) ///
>             mlabsize(small) mlabcolor(red*1.5)) || ///
>         (scatter sci_reliant_ratio_grtyr year_lbl_1 if ep2010, ///
>             yaxis(2) msymbol(none) ///
>             mlabel(pct_label) mlabposition(6) mlabgap(1) ///
>             mlabsize(small) mlabcolor(ebblue*1.5)) || ///
>         (scatter sci_reliant_ratio_grtyr year_lbl_1 if ep2022, ///
>             yaxis(2) msymbol(none) ///
>             mlabel(pct_label) mlabposition(12) mlabgap(1) ///
>             mlabsize(small) mlabcolor(ebblue*1.5)), ///
>         title("{c -(}bf:`ttl'{c )-}", size(medsmall)) ///
>         ytitle("Number", axis(1) size(small)) ///
>         ytitle("Share", axis(2) size(small)) ///
>         ylabel(, axis(1) labsize(small) format(%9.0f)) ///
>         ylabel(0 0.1 "10%" 0.2 "20%" 0.3 "30%" 0.4 "40%" ///
>                0.5 "50%" 0.6 "60%", axis(2) labsize(small)) ///
>         xtitle("Year", size(small) placement(east)) ///
>         xlabel(2010(2)2022, angle(45) labsize(small)) ///
>         legend(off) ///
>         graphregion(margin(vsmall))
{txt} 42{com}. 
.     graph save "${c -(}temp_output{c )-}bg_CNfirm_CNpat_`s'.gph", replace
{txt} 43{com}. 
.     restore
{txt} 44{com}. {c )-}
{txt}(2,480,503 observations deleted)
