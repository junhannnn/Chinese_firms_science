{com}. do "W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\Sci_Pat\3_Supplementary_materials\F4_Additional_analyses\03_Sector_heterogeneity\2_critical_reg_by_sector.do"
{txt}
{com}. /*******************************************************************************
> Project: Science-linked patents—supplementary sector heterogeneity
> Script:  2_critical_reg_by_sector.do
> 
> Purpose:
>   Classify patents into 11 NSF/TIP critical technology areas using IPC codes and
>   test whether the sanction effect differs inside versus outside those areas.
>   Report interaction models and separate-sample estimates.
> 
> Main input (from ${c -(}stata_output{c )-}):
>   - DID_allfirm-level.dta
> 
> Main outputs (under ${c -(}table_output{c )-}):
>   - industry_difference_cri.rtf: pooled and critical-area interaction models
>   - robust_drop_one_industry_cri.rtf: estimates by critical-area status
> 
> Notes:
>   Quantum information science and cybersecurity are represented by broad IPC4
>   proxies because IPC4 codes do not isolate those areas precisely.
> *******************************************************************************/
. 
. use "${c -(}stata_output{c )-}DID_allfirm-level.dta", clear
{txt}
{com}. 
. * ==============================================================================
. * 1. Standardize the IPC-based industry classification
. * ==============================================================================
. 
. capture confirm variable industry
{txt}
{com}. if _rc {c -(}
.     di as error "Variable industry not found."
.     exit 111
. {c )-}
{txt}
{com}. 
. capture drop industry_raw industry_clean ipc4_std ipc3_std
{txt}
{com}. 
. capture confirm string variable industry
{txt}
{com}. if _rc {c -(}
.     tostring industry, gen(industry_raw) force usedisplayformat
. {c )-}
{txt}
{com}. else {c -(}
.     gen str80 industry_raw = industry
. {c )-}
{txt}
{com}. 
. gen str80 industry_clean = upper(strtrim(industry_raw))
{txt}
{com}. replace industry_clean = subinstr(industry_clean, " ", "", .)
{txt}(0 real changes made)

{com}. replace industry_clean = subinstr(industry_clean, ".", "", .)
{txt}(0 real changes made)

{com}. replace industry_clean = subinstr(industry_clean, "/", "", .)
{txt}(0 real changes made)

{com}. replace industry_clean = subinstr(industry_clean, "-", "", .)
{txt}(0 real changes made)

{com}. 
. gen str4 ipc4_std = substr(industry_clean, 1, 4)
{txt}
{com}. gen str3 ipc3_std = substr(industry_clean, 1, 3)
{txt}
{com}. 
. * ==============================================================================
. * 2. Construct indicators for 11 NSF/TIP critical technology areas
. * ==============================================================================
. 
. local techvars ai adv_mfg adv_comm biotech quantum semi adv_energy ///
>                adv_mat disaster cyber cyberinfra
{txt}
{com}. 
. foreach v of local techvars {c -(}
{txt}  2{com}.     capture drop is_`v'
{txt}  3{com}.     gen byte is_`v' = 0
{txt}  4{com}. {c )-}
{txt}
{com}. 
. * Technology area 1: Artificial Intelligence.
. 
. replace is_ai = 1 if inlist(ipc4_std, "G06N", "G06V", "G06T", "G06K", "G10L")
{txt}(43,390 real changes made)

{com}. label var is_ai "Artificial Intelligence"
{txt}
{com}. 
. * Technology area 2: Advanced Manufacturing.
. 
. replace is_adv_mfg = 1 if inlist(ipc3_std, "B21", "B22", "B23", "B24", "B29") ///
>                       | inlist(ipc4_std, "B25J", "B30B", "B33Y", "G05B") ///
>                       | inlist(ipc4_std, "B22F", "B23K", "B23Q", "B29C")
{txt}(307,614 real changes made)

{com}. label var is_adv_mfg "Advanced Manufacturing"
{txt}
{com}. 
. * Technology area 3: Communications and Wireless.
. 
. replace is_adv_comm = 1 if inlist(ipc4_std, "H04B", "H04L", "H04W", "H01Q")
{txt}(70,666 real changes made)

{com}. label var is_adv_comm "Communications and Wireless"
{txt}
{com}. 
. * Technology area 4: Biotechnology.
. 
. replace is_biotech = 1 if inlist(ipc4_std, "C12N", "C12P", "C12Q", "C07K") ///
>                       | inlist(ipc4_std, "A61K", "A61P")
{txt}(92,889 real changes made)

{com}. label var is_biotech "Biotechnology"
{txt}
{com}. 
. * Technology area 5: Quantum Information Science.
. 
. * IPC4 cannot identify quantum precisely.
. * This is a broad IPC4-level proxy.
. replace is_quantum = 1 if inlist(ipc4_std, "G06N", "G02B", "H01L", "H01S")
{txt}(36,846 real changes made)

{com}. label var is_quantum "Quantum Information Science"
{txt}
{com}. 
. * Technology area 6: Semiconductors and Microelectronics.
. 
. replace is_semi = 1 if inlist(ipc4_std, "H01L", "G11C", "B81B", "B81C") ///
>                    | inlist(ipc4_std, "H10B", "H10D", "H10F", "H10H") ///
>                    | inlist(ipc4_std, "H10K", "H10N", "H10P", "H10W") ///
>                    | inlist(ipc4_std, "C30B", "H05K")
{txt}(44,181 real changes made)

{com}. label var is_semi "Semiconductors and Microelectronics"
{txt}
{com}. 
. * Technology area 7: Energy Technology.
. 
. replace is_adv_energy = 1 if inlist(ipc4_std, "H01M", "F03D", "H02J", ///
>                                     "C25B", "F24S", "H02S")
{txt}(56,281 real changes made)

{com}. label var is_adv_energy "Energy Technology"
{txt}
{com}. 
. * Technology area 8: Advanced Materials.
. 
. replace is_adv_mat = 1 if inlist(ipc4_std, "C01B", "C03C", "C04B", "C08J") ///
>                       | inlist(ipc4_std, "C08K", "C08L", "C09D", "C09K") ///
>                       | inlist(ipc4_std, "C21D", "C22C", "C22F", "C23C") ///
>                       | inlist(ipc4_std, "C23F", "C25D", "B32B", "B82Y") ///
>                       | inlist(ipc4_std, "H01B")
{txt}(218,378 real changes made)

{com}. label var is_adv_mat "Advanced Materials"
{txt}
{com}. 
. * Technology area 9: Cyberinfrastructure and Advanced Computing.
. 
. replace is_cyberinfra = 1 if inlist(ipc4_std, "G06F", "G06N", "G06E", "G06T") ///
>                          | inlist(ipc4_std, "G06V", "G11C", "H04L")
{txt}(173,573 real changes made)

{com}. label var is_cyberinfra "Cyberinfrastructure and Advanced Computing"
{txt}
{com}. 
. * Technology area 10: Disaster Risk and Resilience.
. 
. replace is_disaster = 1 if inlist(ipc4_std, "G08B", "G01W", "G01V", "E02B") ///
>                        | inlist(ipc4_std, "A62C", "A62D", "G01S")
{txt}(29,345 real changes made)

{com}. label var is_disaster "Disaster Risk and Resilience"
{txt}
{com}. 
. * Technology area 11: Cybersecurity.
. 
. * IPC4 cannot isolate cybersecurity precisely.
. * This is a broad IPC4-level proxy.
. replace is_cyber = 1 if inlist(ipc4_std, "H04L", "G06F", "H04W")
{txt}(159,327 real changes made)

{com}. label var is_cyber "Cybersecurity"
{txt}
{com}. 
. * Combine the area indicators into an overall critical-technology indicator.
. 
. capture drop n_sectors is_all_cta
{txt}
{com}. 
. egen n_sectors = rowtotal(is_ai is_adv_comm is_biotech is_adv_mfg ///
>                           is_quantum is_semi is_adv_energy is_adv_mat ///
>                           is_cyberinfra is_disaster is_cyber)
{txt}
{com}. label var n_sectors "Number of NSF/TIP technology areas matched"
{txt}
{com}. 
. gen byte is_all_cta = (n_sectors > 0)
{txt}
{com}. label var is_all_cta "All NSF/TIP critical technology areas"
{txt}
{com}. * ==============================================================================
. * 3. Estimate pooled and critical-area interaction models
. * ==============================================================================
. 
. * Estimate the level outcome.
. reghdfe f_cite_science_num_w did whether_pat, absorb(firm_id year) vce(r)
{res}{txt}({browse "http://scorreia.com/research/hdfe.pdf":MWFE estimator} converged in 7 iterations)
