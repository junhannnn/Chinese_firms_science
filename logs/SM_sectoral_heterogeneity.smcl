{txt}
{com}. * ==============================================================================
. * 4. Create IPC-section bubble plots comparing 2010 and 2022
. * ==============================================================================
. 
. * Close any residual postfile handle from a prior run.
. capture postclose P
{txt}
{com}. 
. * Standardize the year variable name if needed.
. capture confirm variable year
{txt}
{com}. if _rc rename grtyr year
{res}{txt}
{com}. 
. local sectors "A B C D E F G H"
{txt}
{com}. 
. tempfile sectorstats
{txt}
{com}. postfile P str40 sector int year double sci_reliant_patent ///
>           double patent_total double share using `sectorstats', replace
{txt}{p 0 4 2}
(file {bf}
C:\Users\Mark\AppData\Local\Temp\ST_255c_00000a.tmp{rm}
not found)
{p_end}

{com}.                   
.                   
. foreach s of local sectors {c -(}
{txt}  2{com}. 
.     preserve
{txt}  3{com}.         keep if is_`s'==1
{txt}  4{com}. 
.         * Calculate annual totals without relying on the type of `apn`.
.         gen byte one = 1
{txt}  5{com}.         collapse (sum) patent_total=one (sum) sci_reliant_patent=cite_science, by(year)
{txt}  6{com}. 
.         gen double share = sci_reliant_patent / patent_total
{txt}  7{com}.         keep if inlist(year,2010,2022)
{txt}  8{com}. 
.         local lab "`ttl_`s''"
{txt}  9{com}. 
.         quietly forvalues i=1/`=_N' {c -(}
{txt} 10{com}.             post P ("`lab'") (year[`i']) (sci_reliant_patent[`i']) (patent_total[`i']) (share[`i'])
{txt} 11{com}.         {c )-}
{txt} 12{com}.     restore
