{txt} 21{com}. 
.         local lab "`ttl_`s''"
{txt} 22{com}. 
.         quietly forvalues i = 1/`=_N' {c -(}
{txt} 23{com}.             post P ("`lab'") (year[`i']) ///
>                    (sci_reliant_patent[`i']) ///
>                    (patent_total[`i']) ///
>                    (share[`i'])
{txt} 24{com}.         {c )-}
{txt} 25{com}. 
.     restore
