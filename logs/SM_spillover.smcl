{com}. do "W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\Sci_Pat\3_Supplementary_materials\F4_Additional_analyses\01_Spillover_effect.do"
{txt}
{com}. /*******************************************************************************
> Project: Science-linked patents—supplementary additional analyses
> Script:  01_Spillover_effect.do
> 
> Purpose:
>   Test for spillovers from sanctioned firms to untreated peers in the same
>   industry or research field, size category, and year. Estimate level,
>   log-transformed, and count models using patent, CNKI, and WOS outcomes.
> 
> Main inputs:
>   - ${c -(}RUN5_STATA_CN_CN{c )-}DID_allfirm-level.dta
>   - ${c -(}RUN5_STATA_CNKI{c )-}CNKI_DID.dta
>   - ${c -(}RUN5_STATA_WOS{c )-}CN_WOS_DID.dta
> 
> Main output:
>   - ${c -(}RUN5_TABLE_CN_CN{c )-}robust_spillover.rtf
> 
> Notes:
>   Run through 3_Supplementary_materials/00_run_all.do so the RUN5_* path globals
>   are available. Source-specific size categories define comparable peer groups.
> *******************************************************************************/
. 
. * ==============================================================================
. * 1. Estimate spillovers for patent-based science-reliance outcomes
. * ==============================================================================
. 
. use ${c -(}RUN5_STATA_CN_CN{c )-}DID_allfirm-level.dta, clear
{txt}
{com}. 
. * Construct patent-based firm-size categories.
. bys firm_id: egen size = sum (f_patent_num)
{txt}
{com}. 
. gen size_category = 0
{txt}
{com}. replace size_category=1 if size<=1 //0-25%
{txt}(1,138,936 real changes made)

{com}. replace size_category=2 if size==2 //25%-50%
{txt}(492,665 real changes made)

{com}. replace size_category=3 if size>2 & size<4 //50%-75%
{txt}(262,759 real changes made)

{com}. replace size_category=4 if size>=4 //75%-100%
{txt}(845,221 real changes made)

{com}. 
. 
. bys industry size_category year: egen did_spillover = max(did) // considering spillover effect
{txt}
{com}. 
. drop if entity_list==1 // drop original treatment group
{txt}(3,152 observations deleted)

{com}. 
. * Estimate the level outcome using linear fixed effects.
. reghdfe f_cite_science_num_w did_spillover whether_pat, absorb(firm_id year) vce(r)
{res}{txt}({browse "http://scorreia.com/research/hdfe.pdf":MWFE estimator} converged in 7 iterations)
{res}
