{com}. do "W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\Sci_Pat\3_Supplementary_materials\F3_Alternative_identification\4_IV_reg.do"
{txt}
{com}. /*******************************************************************************
> Project: Science-linked patents—supplementary alternative identification
> Script:  4_IV_reg.do
> 
> Purpose:
>   Estimate an instrumental-variable specification in which post-2017 exposure
>   to exports to U.S. adversary states instruments for the alternative sanction
>   treatment. Report the baseline DID, first-stage, and two-stage least-squares
>   estimates and summarize the magnitude of the first-stage relationship.
> 
> Main inputs (from ${c -(}stata_output{c )-}):
>   - DID_allfirm-level.dta
>   - firm_id_fapp_mapping.dta
>   - exp_usadver_merge.dta
> 
> Main output (under ${c -(}table_output{c )-}):
>   - IV_USadver_export.rtf: baseline DID, first-stage, and 2SLS estimates
> 
> Notes:
>   Run through 3_Supplementary_materials/00_run_all.do so the shared path globals
>   are available.
> *******************************************************************************/
. 
. * ==============================================================================
. * 1. Assemble the firm-year IV analysis panel
. * ==============================================================================
. 
. use ${c -(}stata_output{c )-}DID_allfirm-level.dta, clear
{txt}
{com}. 
. * Attach the patent-applicant name associated with each firm identifier.
. merge m:1 firm_id using ${c -(}stata_output{c )-}firm_id_fapp_mapping.dta
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}         249,776
{txt}{col 9}from master{col 30}{res}               0{txt}  (_merge==1)
{col 9}from using{col 30}{res}         249,776{txt}  (_merge==2)

{col 5}Matched{col 30}{res}       2,739,581{txt}  (_merge==3)
{col 5}{hline 41}

{com}. drop if _merge==2
{txt}(249,776 observations deleted)

{com}. drop _merge
{txt}
{com}. 
. * Attach adversary-state export exposure by patent-applicant name.
. merge m:1 fapp using ${c -(}stata_output{c )-}exp_usadver_merge.dta
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}       2,588,602
{txt}{col 9}from master{col 30}{res}       2,584,409{txt}  (_merge==1)
{col 9}from using{col 30}{res}           4,193{txt}  (_merge==2)

{col 5}Matched{col 30}{res}         155,172{txt}  (_merge==3)
{col 5}{hline 41}

{com}. 
. replace f_usadver_dummy=0 if _merge==1
{txt}(2,584,409 real changes made)

{com}. replace f_usadver=0 if _merge==1
{txt}(2,584,409 real changes made)

{com}. replace f_usadver_value=0 if _merge==1
{txt}(2,584,409 real changes made)

{com}. 
. replace f_usadver_criarea_dummy=0 if _merge==1
{txt}(2,584,409 real changes made)

{com}. replace f_usadver_criarea=0 if _merge==1
{txt}(2,584,409 real changes made)

{com}. replace f_usadver_value_criarea=0 if _merge==1
{txt}(2,584,409 real changes made)

{com}. 
. drop if _merge==2
{txt}(4,193 observations deleted)

{com}. drop _merge firm_name
{txt}
{com}. 
. 
. order firm_id year did entity_list list_year dif_year ///
> f_usadver_dummy f_usadver f_usadver_value ///
> f_usadver_criarea_dummy f_usadver_criarea f_usadver_value_criarea
{txt}
{com}. 
. gen ratio_criarea = f_usadver_value_criarea/f_usadver_value
{txt}(2,584,409 missing values generated)

{com}. * ==============================================================================
. * 2. Construct the alternative treatment and instrumental variable
. * ==============================================================================
. gen post_trump = year > 2017
{txt}
{com}. 
. gen export_iv = f_usadver_value/100000000 * post_trump
{txt}
{com}. gen did_new = entity_list * post_trump
{txt}
{com}. 
. * ==============================================================================
. * 3. Estimate the baseline DID, first stage, and 2SLS models
. * ==============================================================================
. 
. reghdfe f_cite_science_num_w did_new whether_pat, absorb(firm_id year) vce(r)
{res}{txt}({browse "http://scorreia.com/research/hdfe.pdf":MWFE estimator} converged in 7 iterations)
