{txt}
{com}. 
. * Panel 3: pre-treatment publication outcomes for treated firms.
. use ${c -(}stata_output{c )-}CNKI_DID.dta, clear
{txt}
{com}. keep if entity_list == 1 & year < list_year
{txt}(2,160,249 observations deleted)

{com}. 
. asdoc sum pub_num_w f_u_colla_num_w, ///
>     save(${c -(}table_output{c )-}CNKI_summary_stats.doc) append ///
>     stat(mean)
{res}
{txt}{space 0}{space 0}{ralign 12:}{space 1}{c |}{space 1}{ralign 9:Mean}{space 1}
{space 0}{hline 13}{c   +}{hline 10}
{space 0}{space 0}{ralign 12:pub_num_w}{space 1}{c |}{space 1}{ralign 9:{res:{sf: .4325843}}}{space 1}
