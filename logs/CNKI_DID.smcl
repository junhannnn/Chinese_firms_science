{com}. do "W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\CNKI\01_CNKI_DID.do"
{txt}
{com}. /*******************************************************************************
> Project: CNKI analysis
> Script:  01_CNKI_DID.do
> 
> Purpose:
>   Produce descriptive statistics and baseline difference-in-differences (DID)
>   estimates for publication outcomes in the full Chinese-firm sample. The
>   models report level, log-transformed, and Poisson specifications.
> 
> Main input:
>   ${c -(}stata_output{c )-}CNKI_DID.dta
> 
> Main outputs:
>   - ${c -(}table_output{c )-}CNKI_summary_stats.doc (descriptive and correlation tables)
>   - ${c -(}table_output{c )-}CNKI_main.rtf (baseline DID estimates)
> 
> Required setup:
>   00_run_all.do defines stata_output and table_output before calling this file.
>   The script also requires the community-contributed commands asdoc, reghdfe,
>   ppmlhdfe, and esttab.
> *******************************************************************************/
. 
. * ==============================================================================
. * 1. Produce descriptive statistics
. * ==============================================================================
. 
. use ${c -(}stata_output{c )-}CNKI_DID.dta, clear
{txt}
{com}. 
. * Define publication outcomes and the DID indicator included in summary tables.
. global summary_statistics ///
> pub_num f_u_colla_num pub_num_h f_u_colla_num_h /// Dependent variables
> did // DID indicator
{txt}
{com}. 
. * Append the three descriptive panels to a single Word-compatible document.
. * Panel 1: distributional summary statistics.
. asdoc tabstat $summary_statistics, save(${c -(}table_output{c )-}CNKI_summary_stats.doc) replace stat(N mean sd p50 min max)
{res}
{txt}{space 0}{space 0}{ralign 12:}{space 1}{c |}{space 1}{ralign 9:N}{space 1}{space 1}{ralign 9:Mean}{space 1}{space 1}{ralign 9:SD}{space 1}{space 1}{ralign 9:p50}{space 1}{space 1}{ralign 9:Min}{space 1}{space 1}{ralign 9:Max}{space 1}
{space 0}{hline 13}{c   +}{hline 11}{hline 11}{hline 11}{hline 11}{hline 11}{hline 10}
{space 0}{space 0}{ralign 12:pub_num}{space 1}{c |}{space 1}{ralign 9:{res:{sf:  2176447}}}{space 1}{space 1}{ralign 9:{res:{sf: .3123784}}}{space 1}{space 1}{ralign 9:{res:{sf: 2.272286}}}{space 1}{space 1}{ralign 9:{res:{sf:        0}}}{space 1}{space 1}{ralign 9:{res:{sf:        0}}}{space 1}{space 1}{ralign 9:{res:{sf:      439}}}{space 1}
{space 0}{space 0}{ralign 12:f_u_colla_~m}{space 1}{c |}{space 1}{ralign 9:{res:{sf:  2176447}}}{space 1}{space 1}{ralign 9:{res:{sf: .2063602}}}{space 1}{space 1}{ralign 9:{res:{sf: 1.378745}}}{space 1}{space 1}{ralign 9:{res:{sf:        0}}}{space 1}{space 1}{ralign 9:{res:{sf:        0}}}{space 1}{space 1}{ralign 9:{res:{sf:      324}}}{space 1}
{space 0}{space 0}{ralign 12:pub_num_h}{space 1}{c |}{space 1}{ralign 9:{res:{sf:  2176447}}}{space 1}{space 1}{ralign 9:{res:{sf: .1560677}}}{space 1}{space 1}{ralign 9:{res:{sf: 1.515139}}}{space 1}{space 1}{ralign 9:{res:{sf:        0}}}{space 1}{space 1}{ralign 9:{res:{sf:        0}}}{space 1}{space 1}{ralign 9:{res:{sf:      369}}}{space 1}
{space 0}{space 0}{ralign 12:f_u_colla~_h}{space 1}{c |}{space 1}{ralign 9:{res:{sf:  2176447}}}{space 1}{space 1}{ralign 9:{res:{sf: .1113223}}}{space 1}{space 1}{ralign 9:{res:{sf: .9628283}}}{space 1}{space 1}{ralign 9:{res:{sf:        0}}}{space 1}{space 1}{ralign 9:{res:{sf:        0}}}{space 1}{space 1}{ralign 9:{res:{sf:      277}}}{space 1}
