{com}. do "W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\WOS\04_WOS_dynamic_effect.do"
{txt}
{com}. /*******************************************************************************
> Project: WOS analysis
> Script:  04_WOS_dynamic_effect.do
> 
> Purpose:
>   Estimate dynamic treatment effects for Web of Science (WOS) publication
>   outcomes among Chinese firms and Chinese listed firms using full and
>   coarsened-exact-matching (CEM) samples. The script creates four event-study
>   panels, extracts their coefficients and confidence intervals, and produces a
>   combined two-axis figure.
> 
> Main inputs:
>   - ${c -(}stata_output{c )-}CN_WOS_DID.dta
>   - ${c -(}stata_output{c )-}CN_WOS_DID_cem.dta
>   - ${c -(}stata_output{c )-}CN_WOS_DID_listed.dta
>   - ${c -(}stata_output{c )-}CN_WOS_DID_listed_cem.dta
> 
> Main outputs:
>   - ${c -(}stata_output{c )-}WOS_event_table.dta (event-time estimates by sample)
>   - ${c -(}figure_output{c )-}WOS_dynamic.gph (combined event-study figure)
> 
> Intermediate outputs:
>   ${c -(}figure_output{c )-}dynamic1.gph through dynamic4.gph are created for the initial
>   four-panel graph and deleted after that graph is combined.
> 
> Required setup:
>   00_run_all.do defines stata_output and figure_output before calling this file.
>   The script requires the community-contributed eventdd command and its hdfe
>   estimation dependencies.
> *******************************************************************************/
. 
. * ==============================================================================
. * 1. Estimate dynamic effects for all Chinese firms: full sample
. * ==============================================================================
. 
. use ${c -(}stata_output{c )-}CN_WOS_DID.dta, clear
{txt}
{com}. 
. * Restrict nonmissing event times to the three years before and after treatment.
. gen dif_year = year-list_year
{txt}(1,143,428 missing values generated)

{com}. drop if dif_year!=. & !inrange(dif_year, -3, 3)
{txt}(5,471 observations deleted)

{com}. 
. eventdd pub_num_w, timevar(dif_year) ///
>     method(hdfe, absorb(firm_id year)) ///
>     baseline(0) vce(r) level(95) ///
>     graph_op(ytitle("# of publications indexed by WOS") ///
>              xtitle("Sanction Year") ///
>              title("(A) Chinese firms (full sample)", size(medium)) ///
>              xscale(range(-3 3)) ///
>              legend(off) ///
>              graphregion(color(white)) ///
>              bgcolor(white) ///
>              scheme(journal))
{res}{txt}({browse "http://scorreia.com/research/hdfe.pdf":MWFE estimator} converged in 4 iterations)
{res}
{txt}HDFE Linear regression{col 51}Number of obs{col 67}= {res} 1,147,785
{txt}Absorbing 2 HDFE groups{col 51}F({res}   6{txt},{res}1059055{txt}){col 67}= {res}      8.59
{txt}{col 51}Prob > F{col 67}= {res}    0.0000
{txt}{col 51}R-squared{col 67}= {res}    0.4938
{txt}{col 51}Adj R-squared{col 67}= {res}    0.4514
{txt}{col 51}Within R-sq.{col 67}= {res}    0.0001
{txt}{col 51}Root MSE{col 67}= {res}    0.7087

