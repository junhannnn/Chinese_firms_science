{com}. 
. * ==============================================================================
. * 5. Combine the four initial panels and remove their temporary graph files
. * ==============================================================================
. 
. graph combine ${c -(}figure_output{c )-}dynamic1.gph ${c -(}figure_output{c )-}dynamic2.gph ///
> ${c -(}figure_output{c )-}dynamic3.gph ${c -(}figure_output{c )-}dynamic4.gph
{res}{txt}
{com}. 
. erase ${c -(}figure_output{c )-}dynamic1.gph
{txt}
{com}. erase ${c -(}figure_output{c )-}dynamic2.gph
{txt}
{com}. erase ${c -(}figure_output{c )-}dynamic3.gph
{txt}
{com}. erase ${c -(}figure_output{c )-}dynamic4.gph
{txt}
{com}. 
. * ==============================================================================
. * 6. Build a dataset of event-study estimates and confidence intervals
. * ==============================================================================
. 
. * Map the four stored models to group identifiers used in the combined figure.
. local models M1 M2 M3 M4
{txt}
{com}. local groups A B C D
{txt}
{com}. 
. tempname posth
{txt}
{com}. tempfile  out
{txt}
{com}. postfile `posth' str1 group x y ci_low ci_high using `out', replace
{txt}{p 0 4 2}
(file {bf}
C:\Users\Mark\AppData\Local\Temp\ST_6d0_000001.tmp{rm}
not found)
{p_end}

{com}. local z = invnormal(0.975)
{txt}
{com}. local k = 0
{txt}
{com}. foreach m of local models {c -(}
{txt}  2{com}.     local ++k
{txt}  3{com}.     local g : word `k' of `groups'
{txt}  4{com}.     estimates restore `m'
{txt}  5{com}. 
.     * Inspect coefficient names to identify event-time leads and lags.
.     local names : colnames e(b)
{txt}  6{com}. 
.     * Extract coefficients whose names match the lead or lag naming convention.
.     foreach nm of local names {c -(}
{txt}  7{com}.         * Normalize case before applying the regular-expression matches.
.         local nm_low = lower("`nm'")
{txt}  8{com}. 
.         local matched = 0
{txt}  9{com}.         local x = .
{txt} 10{com}. 
.         * Convert leadK coefficients to negative event times.
.         quietly if regexm("`nm_low'","lead([0-9]+)") {c -(}
{txt} 11{com}.             local K = real(regexs(1))
{txt} 12{com}.             local x = -`K'
{txt} 13{com}.             local matched = 1
{txt} 14{com}.         {c )-}
{txt} 15{com}. 
.         * Convert lagK coefficients to positive event times.
.         quietly if (`matched'==0) & regexm("`nm_low'","lag([0-9]+)") {c -(}
{txt} 16{com}.             local K = real(regexs(1))
{txt} 17{com}.             local x = `K'
{txt} 18{com}.             local matched = 1
{txt} 19{com}.         {c )-}
{txt} 20{com}. 
.         if (`matched') {c -(}
{txt} 21{com}.             * Calculate the 95% confidence interval for the matched coefficient.
.             capture scalar b  = _b[`nm']
{txt} 22{com}.             capture scalar se = _se[`nm']
{txt} 23{com}.             if (_rc==0) {c -(}
{txt} 24{com}.                 scalar lo = b - `z'*se
{txt} 25{com}.                 scalar hi = b + `z'*se
{txt} 26{com}.                 post `posth' ("`g'") (`x') (b) (lo) (hi)
{txt} 27{com}.             {c )-}
{txt} 28{com}.         {c )-}
{txt} 29{com}.     {c )-}
{txt} 30{com}. 
.     * Add the normalized treatment-year baseline at event time zero.
.     post `posth' ("`g'") (0) (0) (0) (0)
{txt} 31{com}. {c )-}
{txt}(results {stata estimates replay M1:M1} are active now)
(results {stata estimates replay M2:M2} are active now)
(results {stata estimates replay M3:M3} are active now)
(results {stata estimates replay M4:M4} are active now)

{com}. postclose `posth'
{txt}
{com}. 
. use `out', clear
{txt}
{com}. order group x y ci_low ci_high
{txt}
{com}. sort group x
{txt}
{com}. 
. save ${c -(}stata_output{c )-}WOS_event_table.dta, replace
{txt}{p 0 4 2}
file {bf}
W:\Mac_Sync\Downloads\ROS\stata_output\WOS\WOS_event_table.dta{rm}
saved
{p_end}

{com}. 
. * ==============================================================================
. * 7. Plot the four event-study series on two y-axes
. * ==============================================================================
. 
. use ${c -(}stata_output{c )-}WOS_event_table.dta, clear
{txt}
{com}. 
. * Offset group coordinates horizontally so estimates at each event time remain visible.
. gen double x_plot = x + ///
>         cond(group=="A", -0.24, ///
>         cond(group=="B", -0.08, ///
>         cond(group=="C",  0.08, ///
>                           0.24)))   // Group D
{txt}
{com}. 
. * Assign a distinct color and marker to each sample definition.
. local colA green*1
{txt}
{com}. local colB ebblue*1.5
{txt}
{com}. local colC purple*1.5
{txt}
{com}. local colD red*1.5
{txt}
{com}. 
. local markA circle
{txt}
{com}. local markB square
{txt}
{com}. local markC triangle
{txt}
{com}. local markD diamond
{txt}
{com}. 
. * Plot confidence intervals and point estimates for all four groups.
. twoway                                                      ///
>     /* Group A — left Y-axis */                             ///
>     (rcap  ci_low ci_high x_plot if group=="A", lcolor(`colA') lwidth(thick) yaxis(1)) ///
>     (scatter y x_plot if group=="A", mcolor(`colA') msymbol(`markA') msize(medsmall) yaxis(1)) ///
>     /* Group B — left Y-axis */                             ///
>     (rcap  ci_low ci_high x_plot if group=="B", lcolor(`colB') lwidth(thick) yaxis(1)) ///
>     (scatter y x_plot if group=="B", mcolor(`colB') msymbol(`markB') msize(medsmall) yaxis(1)) ///
>     /* Group C — right Y-axis */                            ///
>     (rcap  ci_low ci_high x_plot if group=="C", lcolor(`colC') lwidth(thick) yaxis(2)) ///
>     (scatter y x_plot if group=="C", mcolor(`colC') msymbol(`markC') msize(medsmall) yaxis(2)) ///
>     /* Group D — right Y-axis */                            ///
>     (rcap  ci_low ci_high x_plot if group=="D", lcolor(`colD') lwidth(thick) yaxis(2)) ///
>     (scatter y x_plot if group=="D", mcolor(`colD') msymbol(`markD') msize(medsmall) yaxis(2)) ///
>     ,                                                       ///
>     /* Y-axis scales and labels */                          ///
>     yscale(axis(1)) ylabel(-1(0.5)1, axis(1) labsize(medsmall)) ///
>     yscale(axis(2)) ylabel(-10(5)10, axis(2) labsize(medsmall)) ///
>     /* Axis titles and X-axis */                            ///
>     ytitle("{c -(}bf: Chinese Firms'{c )-}""{c -(}bf: International Scientific Production{c )-}", size(medium) axis(1)) ///
>     ytitle("{c -(}bf: Chinese Listed Firms'{c )-}""{c -(}bf: International Scientific Production{c )-}", size(medium) axis(2)) ///
>     xtitle("{c -(}bf: Sanction Year{c )-}", size(medium)) xlabel(-3(1)3, labsize(medium))     ///
>     /* Legend configuration */                              ///
>     legend(order(2 "Chinese firms, full sample (left axis)" ///
>                  4 "Chinese firms, matched sample (left axis)" ///
>                  6 "Chinese listed firms, full sample (right axis)" ///
>                  8 "Chinese listed firms, matched sample (right axis)") ///
>            ring(0) pos(11) col(1) rowgap(*1.2) size(medsmall) region(margin(zero))) ///
>     /* Reference lines */                                   ///
>     yline(0, lpattern(dash) lcolor(gs11))                   ///
>     xline(0, lpattern(dash) lcolor(gs11))                   ///
>     /* Graph layout */                                      ///
>     aspectratio(0.8) graphregion(margin(vsmall))
{res}{txt}
{com}. 
