. * ==============================================================================
. * 6. Build a dataset of event-study estimates and confidence intervals
. * ==============================================================================
. 
. * Map the four stored models to group identifiers used in the combined figure.
. local models M1 M2 M3 M4
{txt}
{com}. local groups A B C D
{txt}
{com}. 
. tempname posth
{txt}
{com}. tempfile  out
{txt}
{com}. postfile `posth' str1 group x y ci_low ci_high using `out', replace
{txt}{p 0 4 2}
(file {bf}
C:\Users\Mark\AppData\Local\Temp\ST_4f14_000001.tmp{rm}
not found)
{p_end}

{com}. local z = invnormal(0.975)
{txt}
{com}. local k = 0
{txt}
{com}. foreach m of local models {c -(}
{txt}  2{com}.     local ++k
{txt}  3{com}.     local g : word `k' of `groups'
{txt}  4{com}.     estimates restore `m'
{txt}  5{com}. 
.     * Inspect coefficient names to identify event-time leads and lags.
.     local names : colnames e(b)
{txt}  6{com}. 
.     * Extract coefficients whose names match the lead or lag naming convention.
.     foreach nm of local names {c -(}
{txt}  7{com}.         * Normalize case before applying the regular-expression matches.
.         local nm_low = lower("`nm'")
{txt}  8{com}. 
.         local matched = 0
{txt}  9{com}.         local x = .
{txt} 10{com}. 
.         * Convert leadK coefficients to negative event times.
.         quietly if regexm("`nm_low'","lead([0-9]+)") {c -(}
{txt} 11{com}.             local K = real(regexs(1))
{txt} 12{com}.             local x = -`K'
{txt} 13{com}.             local matched = 1
{txt} 14{com}.         {c )-}
{txt} 15{com}. 
.         * Convert lagK coefficients to positive event times.
.         quietly if (`matched'==0) & regexm("`nm_low'","lag([0-9]+)") {c -(}
{txt} 16{com}.             local K = real(regexs(1))
{txt} 17{com}.             local x = `K'
{txt} 18{com}.             local matched = 1
{txt} 19{com}.         {c )-}
{txt} 20{com}. 
.         if (`matched') {c -(}
{txt} 21{com}.             * Calculate the 95% confidence interval for the matched coefficient.
.             capture scalar b  = _b[`nm']
{txt} 22{com}.             capture scalar se = _se[`nm']
{txt} 23{com}.             if (_rc==0) {c -(}
{txt} 24{com}.                 scalar lo = b - `z'*se
{txt} 25{com}.                 scalar hi = b + `z'*se
{txt} 26{com}.                 post `posth' ("`g'") (`x') (b) (lo) (hi)
{txt} 27{com}.             {c )-}
{txt} 28{com}.         {c )-}
{txt} 29{com}.     {c )-}
{txt} 30{com}. 
.     * Add the normalized treatment-year baseline at event time zero.
.     post `posth' ("`g'") (0) (0) (0) (0)
{txt} 31{com}. {c )-}
{txt}(results {stata estimates replay M1:M1} are active now)
(results {stata estimates replay M2:M2} are active now)
(results {stata estimates replay M3:M3} are active now)
(results {stata estimates replay M4:M4} are active now)

{com}. postclose `posth'
