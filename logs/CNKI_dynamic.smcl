{col 1}{text}     firm_id{col 14}{c |}{space 1}   167419{col 27}{space 1}        0{col 39}{result}{space 1}   167419{col 53}{text} {col 54}{c |}
{res}{col 1}{text}        year{col 14}{c |}{space 1}       13{col 27}{space 1}        1{col 39}{result}{space 1}       12{col 53}{text} {col 54}{c |}
