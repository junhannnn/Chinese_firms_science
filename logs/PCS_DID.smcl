{com}. 
. * ==============================================================================
. * 6. Construct and export the detailed CEM balance table
. * ==============================================================================
. 
. clear all
{res}{txt}
{com}. set more off
{txt}
{com}. 
. * Use the same CEM panel to calculate unweighted and weighted statistics.
. local prefile  "${c -(}stata_output{c )-}DID_allfirm-level_cem.dta"
{txt}
{com}. local postfile "${c -(}stata_output{c )-}DID_allfirm-level_cem.dta"
{txt}
{com}. 
. * Define the covariates and their reporting order.
. local vars log_before_patent log_before_sci_patent state_owned industry_id province
{txt}
{com}. 
. * Assign one display label to each covariate in the same order.
. local label1 "Log (number of patents filed before listing+1)"
{txt}
{com}. local label2 "Log (Prior scientific foundations+1)"
{txt}
{com}. local label3 "Firm ownership (SOEs=1, non-SOEs=0)"
{txt}
{com}. local label4 "Industry id"
{txt}
{com}. local label5 "Province id"
{txt}
{com}. 
. * Define a reusable helper for posting two-group mean statistics.
. capture program drop _post_mean_two_groups
{txt}
{com}. program define _post_mean_two_groups, rclass
{txt}  1{com}.     syntax, Varname(name) Varlab(string) Handle(name) Stage(string)
{txt}  2{com}.     tempname T
{txt}  3{com}.     matrix `T' = r(table)
{txt}  4{com}.     // Post statistics for control observations (entity_list==0).
.     post ``Handle'' ("`Varlab'") ("Control") ///
>         ( `T'[1,1] ) ( `T'[2,1] ) ( `T'[5,1] ) ( `T'[6,1] ) ("`Stage'")
{txt}  5{com}.     // Post statistics for treated observations (entity_list==1).
.     post ``Handle'' ("`Varlab'") ("Treatment") ///
>         ( `T'[1,2] ) ( `T'[2,2] ) ( `T'[5,2] ) ( `T'[6,2] ) ("`Stage'")
{txt}  6{com}. end
{txt}
{com}. 
. * Calculate unweighted pre-matching means and confidence intervals by group.
. use `prefile', clear
{txt}
{com}. 
. tempname preh
{txt}
{com}. tempfile pretmp
{txt}
{com}. postfile `preh' str80 Variable str10 Group ///
>     double pre_mean pre_se pre_ll pre_ul ///
>     using `pretmp', replace
{txt}{p 0 4 2}
(file {bf}
C:\Users\Mark\AppData\Local\Temp\ST_1384_000001.tmp{rm}
not found)
{p_end}

{com}. 
. local i = 0
{txt}
{com}. foreach v of local vars {c -(}
{txt}  2{com}.     local ++i
{txt}  3{com}.     local vlab `label`i''        // Map each covariate to its display label.
{txt}  4{com}.     quietly mean `v', over(entity_list)
{txt}  5{com}.     tempname T
{txt}  6{com}.     matrix `T' = r(table)
{txt}  7{com}.     // Post control-group statistics.
.     post `preh' ("`vlab'") ("Control") ///
>         (`T'[1,1]) (`T'[2,1]) (`T'[5,1]) (`T'[6,1])
{txt}  8{com}.     // Post treatment-group statistics.
.     post `preh' ("`vlab'") ("Treatment") ///
>         (`T'[1,2]) (`T'[2,2]) (`T'[5,2]) (`T'[6,2])
{txt}  9{com}. {c )-}
{txt}
{com}. postclose `preh'
{txt}
{com}. 
. use `pretmp', clear
{txt}
{com}. tempfile predata
{txt}
{com}. save `predata', replace
