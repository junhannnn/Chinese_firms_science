{com}. 
. * Merge pre- and post-matching statistics by covariate and treatment group.
. use `predata', clear
{txt}
{com}. merge 1:1 Variable Group using `postdata', nogen
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}               0
{txt}{col 5}Matched{col 30}{res}              10{txt}  
{col 5}{hline 41}

{com}. 
. order Variable Group pre_mean pre_se pre_ll pre_ul post_mean post_se post_ll post_ul
{txt}
{com}. sort Variable Group
{txt}
{com}. 
. * Restore the covariate order defined above.
. gen order = .
{txt}(10 missing values generated)

{com}. replace order = 1 if Variable == "`label1'"
{txt}(2 real changes made)

{com}. replace order = 2 if Variable == "`label2'"
{txt}(2 real changes made)

{com}. replace order = 3 if Variable == "`label3'"
{txt}(2 real changes made)

{com}. replace order = 4 if Variable == "`label4'"
{txt}(2 real changes made)

{com}. replace order = 5 if Variable == "`label5'"
{txt}(2 real changes made)

{com}. sort order Group
{txt}
{com}. drop order
{txt}
{com}. 
. * Format confidence intervals and export the final balance table.
. preserve
{txt}
{com}.     * Format confidence intervals as bracketed strings with three decimals.
.     gen str20 pre_ci  = "[" + string(pre_ll,  "%9.3f") + ", " + string(pre_ul,  "%9.3f") + "]"
{txt}
{com}.     gen str20 post_ci = "[" + string(post_ll, "%9.3f") + ", " + string(post_ul, "%9.3f") + "]"
{txt}
{com}. 
.     * Export selected pre- and post-matching columns with descriptive labels.
.     asdoc list ///
>         Variable Group ///
>         pre_mean pre_se pre_ci ///
>         post_mean post_se post_ci, ///
>         save(${c -(}table_output{c )-}main_cem_balance.doc) replace ///
>         title(Balance: Pre- vs Post-Matching) ///
>         dec(3)
