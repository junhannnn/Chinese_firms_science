{com}. 
. * ==============================================================================
. * 2. Calculate pre-treatment means for treated firms
. * ==============================================================================
. 
. * Calculate the full-sample mean before each treated firm's listing year.
. use ${c -(}stata_output{c )-}DID_allfirm-level.dta, clear
{txt}
{com}. keep if entity_list==1 & year<list_year
{txt}(2,737,020 observations deleted)

{com}. quietly summarize f_cite_science_num_w
{txt}
{com}. scalar m_base = r(mean)
{txt}
{com}. 
. * Calculate the corresponding mean among CEM-matched treated observations.
. use ${c -(}stata_output{c )-}DID_allfirm-level_cem.dta, clear
{txt}
{com}. keep if cem_matched==1
{txt}(2,028,164 observations deleted)

{com}. keep if entity_list==1 & year<list_year
{txt}(709,464 observations deleted)

{com}. quietly summarize f_cite_science_num_w
{txt}
{com}. scalar m_cem = r(mean)
{txt}
{com}. 
. * Build a two-row reporting dataset containing the stored means.
. clear
{txt}
{com}. input str64 group double mean_f_cite_science_num_w

     {txt}                                                           group  mean_f_c~w
  1{com}. "pre-treatment mean (all sample)" .
{txt}  2{com}. "pre-treatment mean (after CEM)"      .
{txt}  3{com}. end
{txt}
{com}. replace mean_f_cite_science_num_w = m_base in 1
{txt}(1 real change made)

{com}. replace mean_f_cite_science_num_w = m_cem in 2
{txt}(1 real change made)

{com}. 
. * Print a diagnostic path; the asdoc command below appends to main_summary_stats.doc.
. di as txt "Writing to: " "${c -(}table_output{c )-}summary_stats_main.doc"
{res}{txt}Writing to: W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\Sci_Pat/../../table_output/CN_CN/summary_stats_main.doc

