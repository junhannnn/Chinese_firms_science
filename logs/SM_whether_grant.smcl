{txt}{col 51}R-squared{col 67}= {res}    0.3325
{txt}{col 51}Adj R-squared{col 67}= {res}    0.2800
{txt}{col 51}Within R-sq.{col 67}= {res}    0.0386
{txt}{col 1}Number of clusters ({res}firm_id{txt}) {col 30}= {res}   345,507{txt}{col 51}Root MSE{col 67}= {res}    0.4126

