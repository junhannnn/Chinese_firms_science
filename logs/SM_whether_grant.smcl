{txt}{space 6}patent_scope {c |}{col 20}{res}{space 2} -.005255{col 32}{space 2} .0004821{col 43}{space 1}  -10.90{col 52}{space 3}0.000{col 60}{space 4}-.0061999{col 73}{space 3}-.0043102
