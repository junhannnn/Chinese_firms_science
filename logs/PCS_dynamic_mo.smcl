{com}. * ==============================================================================
. * 4. Assemble subgroup event-study estimates into an analysis dataset
. * ==============================================================================
. 
. local models M1 M2 M3 M4 M5 M6 M7 M8
{txt}
{com}. local groups A  A  B  B  C  C  D  D
{txt}
{com}. local dep    low high low high low high low high
{txt}
{com}. 
. tempname posth
{txt}
{com}. tempfile  out
{txt}
{com}. 
. * Store numeric results as doubles to avoid precision loss.
. postfile `posth' ///
>     str1   group ///
>     str4   dep   ///
>     double x     ///
>     double y     ///
>     double ci_low double ci_high ///
>     using `out', replace
{txt}{p 0 4 2}
(file {bf}
C:\Users\Mark\AppData\Local\Temp\ST_6a8_000001.tmp{rm}
not found)
{p_end}

{com}. 
. * Use the standard-normal critical value for 95% confidence intervals.
. local z95 = invnormal(0.975)   // 95% CI
{txt}
{com}. 
. local k = 0
{txt}
{com}. foreach m of local models {c -(}
{txt}  2{com}.     local ++k
{txt}  3{com}.     local g : word `k' of `groups'
{txt}  4{com}.     local d : word `k' of `dep'
{txt}  5{com}. 
.         local z_model = `z95'
{txt}  6{com}. 
.     estimates restore `m'
{txt}  7{com}. 
.     local names : colnames e(b)
{txt}  8{com}. 
.     foreach nm of local names {c -(}
{txt}  9{com}.         local nm_low = lower("`nm'")
{txt} 10{com}. 
.         local matched = 0
{txt} 11{com}.         local x = .
{txt} 12{com}. 
.         * Map leadK coefficients to negative event time.
.         quietly if regexm("`nm_low'", "lead([0-9]+)") {c -(}
{txt} 13{com}.             local K = real(regexs(1))
{txt} 14{com}.             local x = -`K'
{txt} 15{com}.             local matched = 1
{txt} 16{com}.         {c )-}
{txt} 17{com}. 
.         * Map lagK coefficients to positive event time.
.         quietly if (`matched'==0) & regexm("`nm_low'", "lag([0-9]+)") {c -(}
{txt} 18{com}.             local K = real(regexs(1))
{txt} 19{com}.             local x = `K'
{txt} 20{com}.             local matched = 1
{txt} 21{com}.         {c )-}
{txt} 22{com}. 
.         if (`matched') {c -(}
{txt} 23{com}.             capture scalar b  = _b[`nm']
{txt} 24{com}.             capture scalar se = _se[`nm']
{txt} 25{com}.             if (_rc == 0) {c -(}
{txt} 26{com}.                 scalar lo = b - `z_model'*se
{txt} 27{com}.                 scalar hi = b + `z_model'*se
{txt} 28{com}.                 post `posth' ("`g'") ("`d'") (`x') (b) (lo) (hi)
{txt} 29{com}.             {c )-}
{txt} 30{com}.         {c )-}
{txt} 31{com}.     {c )-}
{txt} 32{com}. 
.     * Add the omitted baseline at event time zero.
.     post `posth' ("`g'") ("`d'") (0) (0) (0) (0)
{txt} 33{com}. {c )-}
{txt}(results {stata estimates replay M1:M1} are active now)
(results {stata estimates replay M2:M2} are active now)
(results {stata estimates replay M3:M3} are active now)
(results {stata estimates replay M4:M4} are active now)
(results {stata estimates replay M5:M5} are active now)
(results {stata estimates replay M6:M6} are active now)
(results {stata estimates replay M7:M7} are active now)
(results {stata estimates replay M8:M8} are active now)

{com}. 
. postclose `posth'
{txt}
{com}. 
. use `out', clear
{txt}
{com}. order group dep x y ci_low ci_high
{txt}
{com}. sort dep group x
{txt}
{com}. 
. save ${c -(}stata_output{c )-}ROS_event_table_mo.dta, replace
{txt}{p 0 4 2}
