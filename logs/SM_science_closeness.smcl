{res}{col 1}{text}{hline 13}{c +}{hline 12}{hline 12}{hline 14}{hline 1}{c RT}
{col 1}{text}     firm_id{col 14}{c |}{space 1}   136404{col 27}{space 1}        0{col 39}{result}{space 1}   136404{col 53}{text} {col 54}{c |}
{res}{col 1}{text}        year{col 14}{c |}{space 1}       13{col 27}{space 1}        1{col 39}{result}{space 1}       12{col 53}{text} {col 54}{c |}
{res}{col 1}{text}{hline 13}{c BT}{hline 12}{hline 12}{hline 14}{hline 1}{c BRC}
{res}{txt}
{com}. est store M2
{txt}
{com}. * ==============================================================================
. * 3. Export the combined science-closeness table
. * ==============================================================================
. 
. esttab M1 M2 using ${c -(}table_output{c )-}science_closeness.rtf, ///
>     replace star( * 0.10 ** 0.05 *** 0.01 ) nogaps compress ///
>     b(%20.3f) se(%7.3f) r2(%9.3f) ///
>     stats(N r2 r2_p, fmt(%15.0fc %9.3f %9.3f) labels("Observations" "R2" "Pseudo R2")) ///
>     mtitles("Model 1" "Model 2") ///
>     nonotes
{res}{txt}(output written to {browse  `"W:\Mac_Sync\Desktop\public_release_science_20260904\analytics\Sci_Pat/../../table_output/CN_CN/science_closeness.rtf"'})

{com}. 
. 
